## Draws one item's picture, centered on a point. A silhouette is all one color.
static func draw(canvas: CanvasItem, id: String, center: Vector2, scale: int = 2, silhouette: bool = false, silhouette_color: Color = SILHOUETTE) -> void:
	var rows: Array = ART.get(id, [])
	var left: float = round(center.x - float(SIZE * scale) / 2.0)
	var top: float = round(center.y - float(SIZE * scale) / 2.0)
	for y in rows.size():
		var row: String = rows[y]
		var x: int = 0
		while x < row.length():
			var letter: String = row[x]
			var run: int = 1
			while x + run < row.length() and row[x + run] == letter:
				run += 1
			if letter != ".":
				var color: Color = silhouette_color if silhouette else COLORS.get(letter, Color.MAGENTA)
				canvas.draw_rect(Rect2(left + float(x * scale), top + float(y * scale), run * scale, scale), color)
			x += run
